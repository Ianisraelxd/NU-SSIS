# Copy to .env to change settings (then restart npm run dev).

# Database. Leave empty to use the embedded PostgreSQL (nothing to install).
# To use Neon (or any PostgreSQL), paste the connection string from the Neon dashboard → Connect (pooled):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# LMS-style extras (class activities, private task comments, Faculty portal) are outside the project scope
# and OFF by default. Set BOTH to true to switch them back on.
ENABLE_LMS=false
VITE_ENABLE_LMS=false
